# Flask session secret
SECRET_KEY=replace-with-a-long-random-value

# Gmail SMTP App Password for UTR notifications
SYSTEM_EMAIL=your-email@gmail.com
SYSTEM_PASSWORD=your-gmail-app-password

# Optional: use a mounted persistent path in production
# DATABASE_PATH=database/localmart.db

# Optional: GitHub Pages or other separately hosted frontend origin
# FRONTEND_ORIGIN=https://your-name.github.io

# Optional existing payment gateway verification endpoint
# UPI_GATEWAY_URL=
